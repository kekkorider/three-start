      "typeHtml": "<span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">THREE</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">.Scene</span>",
      "optional": true,
      "description": "Override the default `Scene`. If not provided, an empty scene is created."
    },
    {
      "name": "manageLoopManually",
      "type": "boolean",
      "typeHtml": "<span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">boolean</span>",
